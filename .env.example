# Copy to .env and fill in values

# Groq (primary LLM — all agents use this for MVP)
GROQ_API_KEY=your_groq_api_key_here

# Database
DATABASE_URL=postgresql://casefile:casefile@localhost:5432/casefile_db

# Security
SECRET_KEY=change_me_to_a_random_32_char_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File storage (local for MVP, swap to S3 later)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
